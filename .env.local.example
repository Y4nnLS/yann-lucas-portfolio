# Local development only. Overrides .env for the API; Docker keeps using .env.
# Run backend commands from backend/ so these paths stay in that directory.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./portfolio.db
MEDIA_ROOT=./media
MEDIA_BASE_URL=/media
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ADMIN_EMAIL, ADMIN_PASSWORD and JWT_SECRET_KEY are inherited from .env.
